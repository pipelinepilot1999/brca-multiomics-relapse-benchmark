manifest {
    name            = 'biomarker-signature-brca'
    author          = 'multi-omics relapse signature pipeline'
    description     = 'Multi-omics biomarker signature for breast cancer relapse (TCGA-BRCA -> METABRIC)'
    version         = '1.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

// Reproducibility: the analysis seed is set in config/config.yaml and recorded
// by every script. Nextflow itself contributes no randomness.

process {
    errorStrategy = 'terminate'
    maxRetries    = 0

    withLabel: light { cpus = 2; memory = '8 GB'  }
    withLabel: heavy { cpus = 8; memory = '48 GB' }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g) -v $PWD:$PWD'
        process.container = 'biomarker-brca:1.0'
    }

    conda {
        conda.enabled     = true
        process.conda     = "$projectDir/../env/environment.yml"
    }

    smoke {
        params.config = 'config/config_smoke.yaml'
        params.subset = 100
        params.fast   = true
        process {
            withLabel: light { cpus = 2; memory = '4 GB' }
            withLabel: heavy { cpus = 4; memory = '8 GB' }
        }
    }
}

report   { enabled = true; overwrite = true; file = "${projectDir}/../results/nextflow/report.html"   }
timeline { enabled = true; overwrite = true; file = "${projectDir}/../results/nextflow/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${projectDir}/../results/nextflow/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${projectDir}/../results/nextflow/dag.html"      }
